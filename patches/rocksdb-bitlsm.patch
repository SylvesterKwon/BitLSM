+    return Status::NotFound("No user-defined index in file " +
+                            rep_->file->file_name());
+  }
+  if (rep_->udi_meta_block != nullptr) {
+    // Metadata-only reader, pinned for the table's lifetime regardless of
+    // cache_index_and_filter_blocks; checked first since neither of the
+    // branches below applies to it.
+    assert(rep_->udi_meta_block->reader() != nullptr);
+    out_entry->SetUnownedValue(rep_->udi_meta_block.get());
+    return Status::OK();
+  }
+  if (!rep_->table_options.cache_index_and_filter_blocks) {
+    // The block was read and parsed once at open and is pinned for the
+    // table's lifetime; hand out an unowned reference to it.
+    if (rep_->udi_block_pinned.IsEmpty()) {
+      return Status::NotFound("No user-defined index in file " +
+                              rep_->file->file_name());
+    }
+    assert(rep_->udi_block_pinned.GetValue()->reader() != nullptr);
+    out_entry->SetUnownedValue(rep_->udi_block_pinned.GetValue());
+    return Status::OK();
+  }
