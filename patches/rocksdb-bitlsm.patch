+Status BlockBasedTable::GetUserDefinedIndexReader(
+    const ReadOptions& read_options,
+    CachableEntry<Block_kUserDefinedIndex>* out_entry) const {
+  assert(out_entry != nullptr);
+  if (rep_->udi_handle.IsNull()) {
+    return Status::NotFound("No user-defined index in file " +
+                            rep_->file->file_name());
+  }
+  BlockCacheLookupContext lookup_context{TableReaderCaller::kUserIterator};
+  Status s = RetrieveBlock(
+      /*prefetch_buffer=*/nullptr, read_options, rep_->udi_handle,
+      rep_->decompressor.get(), out_entry,
+      /*get_context=*/nullptr, &lookup_context,
+      /*for_compaction=*/false, /*use_cache=*/true,
+      /*async_read=*/false, /*use_block_cache_for_lookup=*/true);
+  if (!s.ok()) {
+    return s;
+  }
+  assert(!out_entry->IsEmpty());
+  if (out_entry->GetValue()->reader() == nullptr) {
+    return Status::Corruption("Failed to create UDI reader in file " +
+                              rep_->file->file_name());
+  }
+  return s;
+}
