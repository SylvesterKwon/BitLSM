+TEST_P(UserDefinedIndexTest, EvictAndReload) {
+  BlockBasedTableOptions table_options;
+  std::string dbname = test::PerThreadDBPath("udi_evict_reload_test");
+  std::string sst_file = dbname + "test.sst";
+
+  auto udi_factory = std::make_shared<TestUserDefinedIndexFactory>();
+  std::shared_ptr<Cache> cache = NewLRUCache(32 << 20);
+  table_options.user_defined_index_factory = udi_factory;
+  table_options.block_cache = cache;
+  table_options.cache_index_and_filter_blocks = true;
+  table_options.flush_block_policy_factory =
+      std::make_shared<CustomFlushBlockPolicyFactory>();
+  options_.table_factory.reset(NewBlockBasedTableFactory(table_options));
+
+  std::unique_ptr<SstFileWriter> writer(
+      new SstFileWriter(EnvOptions(), options_));
+  ASSERT_OK(writer->Open(sst_file));
+  auto kvs = generateKVs(/*key_count*/ 100);
+  for (const auto& kv : kvs) {
+    ASSERT_OK(writer->Put(kv.first, kv.second));
+  }
+  ASSERT_OK(writer->Finish());
+  writer.reset();
+
+  // Open a BlockBasedTable directly so we can exercise the new API.
+  ImmutableOptions ioptions(options_);
+  MutableCFOptions moptions((ColumnFamilyOptions(options_)));
+  EnvOptions eoptions(options_);
+  TableReaderOptions toptions(
+      ioptions, moptions.prefix_extractor,
+      /*_compression_manager=*/nullptr, eoptions, ioptions.internal_comparator,
+      moptions.block_protection_bytes_per_key,
+      /*skip_filters*/ false, /*immortal*/ false,
+      /*force_direct_prefetch*/ false, /*level*/ -1,
+      /*block_cache_tracer*/ nullptr,
+      /*max_file_size_for_l0_meta_pin*/ 0, /*cur_db_session_id*/ "",
+      /*cur_file_num*/ 0,
+      /* unique_id */ {}, /* largest_seqno */ 0,
+      /* tail_size */ 0, ioptions.persist_user_defined_timestamps);
+  uint64_t file_size = 0;
+  std::unique_ptr<FSRandomAccessFile> file;
+  const auto& fs = options_.env->GetFileSystem();
+  ASSERT_OK(fs->GetFileSize(sst_file, IOOptions(), &file_size, nullptr));
+  ASSERT_OK(fs->NewRandomAccessFile(sst_file, eoptions, &file, nullptr));
+  std::unique_ptr<RandomAccessFileReader> file_reader(
+      new RandomAccessFileReader(std::move(file), sst_file));
+  std::unique_ptr<TableReader> table;
+  ASSERT_OK(options_.table_factory->NewTableReader(
+      toptions, std::move(file_reader), file_size, &table,
+      /*prefetch_index_and_filter_in_cache=*/true));
+  auto* bbt = static_cast<BlockBasedTable*>(table.get());
+
+  // 1. Fetch: entry is cached, pinned, and carries a parsed reader.
+  CachableEntry<Block_kUserDefinedIndex> entry;
+  ASSERT_OK(bbt->GetUserDefinedIndexReader(ReadOptions(), &entry));
+  ASSERT_FALSE(entry.IsEmpty());
+  ASSERT_NE(entry.GetValue()->reader(), nullptr);
+  ASSERT_TRUE(entry.IsCached());
+  const size_t creates_after_first = udi_factory->reader_create_count_;
+
+  // 2. While pinned, eviction of unreferenced entries must not touch it.
+  cache->EraseUnRefEntries();
+  ASSERT_NE(entry.GetValue()->reader(), nullptr);
+
+  // 3. Release the pin and evict everything.
+  entry.Reset();
+  cache->EraseUnRefEntries();
+
+  // 4. Re-fetch: the block is re-read from the file and re-parsed.
+  CachableEntry<Block_kUserDefinedIndex> entry2;
+  ASSERT_OK(bbt->GetUserDefinedIndexReader(ReadOptions(), &entry2));
+  ASSERT_FALSE(entry2.IsEmpty());
+  ASSERT_NE(entry2.GetValue()->reader(), nullptr);
+  // The re-fetch must have re-parsed the reader (i.e. a real reload, not a
+  // still-cached or re-pinned entry).
+  ASSERT_GT(udi_factory->reader_create_count_, creates_after_first);
+}
